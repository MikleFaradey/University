# Copy to .env. Use independent random secrets for a non-demo deployment.
TASK_PORT=8001
NOTIFICATION_PORT=8002
AUDIT_PORT=8003
TASK_DB_PATH=/data/tasks.db
NOTIFICATION_DB_PATH=/data/notifications.db
AUDIT_DB_PATH=/data/audit.db
NOTIFICATION_URL=http://notification:8002
AUDIT_URL=http://audit:8003
JWT_SECRET=replace-with-a-long-random-jwt-secret
SERVICE_API_KEY=replace-with-a-long-random-service-key
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
HTTP_TIMEOUT_SECONDS=1.5
OUTBOX_RETRY_SECONDS=15
DEADLINE_SCAN_SECONDS=300
