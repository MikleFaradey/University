 {rank=same; auth;operations;policy;observers}
 host -> loader; loader -> registry;loader -> bus;loader -> cli;
 registry -> auth [label="API"]; registry -> operations [label="API"]; registry -> policy [label="API"];
 bus -> policy [label="requested",dir=both]; bus -> observers [label="completed"];
 cli -> auth [label="commands"];cli -> operations [label="commands"];
