digraph G {
 graph [fontname="DejaVu Sans", bgcolor="white", ranksep="0.65", nodesep="0.35", pad="0.28", label="Архитектура модульной банковской системы", labelloc=t, fontsize=20];
 node [shape=box,style="rounded,filled",fontname="DejaVu Sans",color="#A9BDCE",fillcolor="#F1F5FA",fontsize=12]; edge [color="#557A95",fontname="DejaVu Sans",fontsize=10];
 host [label="host/main.py\nconfig.toml",fillcolor="#D7EBF7"];
 loader [label="core/loader.py\nentry_points"];
 registry [label="Registry\nсервисы по Protocol"];
 bus [label="EventBus\nзапросы и уведомления"];
 cli [label="CommandRegistry\nкоманды каждого плагина"];
 auth [label="auth + accounts"];
 operations [label="deposits + withdrawals\ntransfers + reports"];
 policy [label="limits + fees\nfraud_control + currency"];
 observers [label="notifications + audit_log\nbonus_points + analytics"];
 storage [label="persistence\nSQLite / :memory:",fillcolor="#E3F4E9"];
