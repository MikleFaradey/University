digraph workflow {
graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.28, ranksep=0.85, label="Жизненный цикл счета", labelloc=t, fontsize=21, fontname="DejaVu Sans", splines=ortho];
node [shape=box, style="rounded,filled", color="#C5D2E3", fillcolor="#EDF3FA", fontname="DejaVu Sans", fontsize=12, penwidth=1.1];
edge [fontname="DejaVu Sans", fontsize=10, color="#52647B", fontcolor="#3C475A"];
"Клиент" [label="Клиент"];
"accounts" [label="accounts"];
"Repository" [label="Repository"];
"EventBus" [label="EventBus",fillcolor="#E1EDFF"];
"notifications" [label="notifications"];
"reports" [label="reports"];
"audit_log" [label="audit_log"];
"Клиент" -> "accounts" [label="Открыть / закрыть счет",constraint=false];
"accounts" -> "Repository" [label="Проверить владельца, валюту и остаток",constraint=false];
"accounts" -> "Repository" [label="INSERT / UPDATE",constraint=false];
"accounts" -> "EventBus" [label="account.opened / account.closed",constraint=false];
"EventBus" -> "notifications" [label="Уведомление",constraint=false];
"EventBus" -> "reports" [label="Проекция истории",constraint=false];
"EventBus" -> "audit_log" [label="Запись в аудит",constraint=false];
{rank=same; "Клиент"; "accounts"; "Repository"; "EventBus"; "notifications"; "reports"; "audit_log";}
}