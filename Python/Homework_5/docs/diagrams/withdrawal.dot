digraph workflow {
graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.28, ranksep=0.85, label="Снятие", labelloc=t, fontsize=21, fontname="DejaVu Sans", splines=ortho];
node [shape=box, style="rounded,filled", color="#C5D2E3", fillcolor="#EDF3FA", fontname="DejaVu Sans", fontsize=12, penwidth=1.1];
edge [fontname="DejaVu Sans", fontsize=10, color="#52647B", fontcolor="#3C475A"];
"Клиент" [label="Клиент"];
"withdrawals" [label="withdrawals"];
"EventBus" [label="EventBus",fillcolor="#E1EDFF"];
"limits" [label="limits"];
"fraud_control" [label="fraud_control"];
"Repository" [label="Repository"];
"accounts" [label="accounts"];
"reports" [label="reports"];
"analytics" [label="analytics"];
"notifications" [label="notifications"];
"Клиент" -> "withdrawals" [label="withdraw",constraint=false];
"withdrawals" -> "EventBus" [label="withdrawal.requested",constraint=false];
"EventBus" -> "limits" [label="Дневной и месячный лимит",constraint=false];
"EventBus" -> "fraud_control" [label="Порог подозрительности",constraint=false];
"withdrawals" -> "Repository" [label="BEGIN IMMEDIATE",constraint=false];
"withdrawals" -> "accounts" [label="debit (проверка баланса)",constraint=false];
"withdrawals" -> "Repository" [label="Записать и COMMIT либо ROLLBACK",constraint=false];
"withdrawals" -> "EventBus" [label="money.withdrawn",constraint=false];
"EventBus" -> "reports" [label="Проекция",constraint=false];
"EventBus" -> "analytics" [label="Счетчик",constraint=false];
"EventBus" -> "notifications" [label="Уведомление",constraint=false];
{rank=same; "Клиент"; "withdrawals"; "EventBus"; "limits"; "fraud_control"; "Repository"; "accounts"; "reports"; "analytics"; "notifications";}
}