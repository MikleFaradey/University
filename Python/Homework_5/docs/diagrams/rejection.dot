digraph workflow {
graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.28, ranksep=0.85, label="Отказ и обнаружение мошенничества", labelloc=t, fontsize=21, fontname="DejaVu Sans", splines=ortho];
node [shape=box, style="rounded,filled", color="#C5D2E3", fillcolor="#EDF3FA", fontname="DejaVu Sans", fontsize=12, penwidth=1.1];
edge [fontname="DejaVu Sans", fontsize=10, color="#52647B", fontcolor="#3C475A"];
"Клиент" [label="Клиент"];
"transfers" [label="transfers"];
"EventBus" [label="EventBus",fillcolor="#E1EDFF"];
"limits" [label="limits"];
"fraud_control" [label="fraud_control"];
"admin" [label="admin"];
"notifications" [label="notifications"];
"audit_log" [label="audit_log"];
"Клиент" -> "transfers" [label="Запрос перевода",constraint=false];
"transfers" -> "EventBus" [label="transfer.requested",constraint=false];
"EventBus" -> "limits" [label="Отказ при превышении лимита",constraint=false];
"EventBus" -> "fraud_control" [label="Проверка подозрительной суммы",constraint=false];
"fraud_control" -> "EventBus" [label="fraud.detected",constraint=false];
"EventBus" -> "admin" [label="Создать уведомление админу",constraint=false];
"EventBus" -> "notifications" [label="Уведомить о риске",constraint=false];
"transfers" -> "EventBus" [label="transfer.rejected",constraint=false];
"EventBus" -> "notifications" [label="Уведомить об отказе",constraint=false];
"EventBus" -> "audit_log" [label="Записать причину",constraint=false];
{rank=same; "Клиент"; "transfers"; "EventBus"; "limits"; "fraud_control"; "admin"; "notifications"; "audit_log";}
}