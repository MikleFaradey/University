"deposits" -> "EventBus" [label="money.deposited",constraint=false];
"EventBus" -> "reports" [label="Проекция",constraint=false];
"EventBus" -> "bonus_points" [label="Начислить баллы",constraint=false];
"EventBus" -> "notifications" [label="Уведомление",constraint=false];
{rank=same; "Клиент"; "deposits"; "EventBus"; "limits"; "fraud_control"; "Repository"; "accounts"; "reports"; "bonus_points"; "notifications";}
